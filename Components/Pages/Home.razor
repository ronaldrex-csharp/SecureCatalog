@page "/"

<div class="text-center mt-5">

    <h1 class="display-4">Welcome to SecureCatalog</h1>

    <p class="lead">
        Securely manage products with a modern
        ASP.NET Core and Blazor application.
    </p>

</div>

<div class="row mt-5">

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Product Management</h5>
                <p>Create, update, and manage products.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Security</h5>
                <p>Identity authentication and authorization.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Architecture</h5>
                <p>Dapper, MediatR, CQRS, and Serilog.</p>
            </div>
        </div>
    </div>

</div>

<div class="text-center mt-5">
    <a href="/products" class="btn btn-primary btn-lg">
        View Products
    </a>
</div>